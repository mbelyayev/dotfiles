{{ $osID := default "" (index .chezmoi.osRelease "id") }}

[settings]
{{- if eq .chezmoi.os "darwin" }}
system_packages.managers = ["brew", "brew-cask"]
{{- else if eq .chezmoi.os "linux" }}
system_packages.managers = ["apt", "flatpak-user"]
{{- end }}

idiomatic_version_file_enable_tools = ["python"]
python.uv_venv_auto = "source"


[bootstrap.hooks.pre-packages]
{{ if eq $osID "ubuntu" "debian" }}
run = [
  # https://yazi-rs.github.io/docs/installation#apt
  "curl -fsSL https://yazi-rs.github.io/builds/yazi-keyring.gpg | sudo tee /usr/share/keyrings/yazi-keyring.gpg >/dev/null",
  "echo 'deb [signed-by=/usr/share/keyrings/yazi-keyring.gpg] https://yazi-rs.github.io/builds/ stable main' | sudo tee /etc/apt/sources.list.d/yazi.list >/dev/null",
  {{- if eq .hostType "desktop" -}}
  # https://brave.com/linux/
  "sudo curl -fsSLo /usr/share/keyrings/brave-browser-archive-keyring.gpg https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg",
  "sudo curl -fsSLo /etc/apt/sources.list.d/brave-browser-release.sources https://brave-browser-apt-release.s3.brave.com/brave-browser.sources",
  {{- end -}}
  "sudo apt update"
]
{{- end }}

[bootstrap.packages]
# CLI tools and libraries
## macOS
"brew:zsh-syntax-highlighting" = "latest"
"brew:zsh-autosuggestions" = "latest"
"brew:tmux" = "latest"
"brew:sesh" = "latest"
"brew:neovim" = "latest"
### yazi and dependencies
"brew:yazi" = "latest"
"brew:ffmpeg" = "latest"
"brew:sevenzip" = "latest"
"brew:jq" = "latest"
"brew:poppler" = "latest"
"brew:fd" = "latest"
"brew:ripgrep" = "latest"
"brew:fzf" = "latest"
"brew:zoxide" = "latest"
"brew:resvg" = "latest"
"brew:imagemagick" = "latest"
### more tools
"brew:bat" = "latest"
"brew:starship" = "latest"
"brew:yt-dlp" = "latest"
"brew:podman" = "latest"
## Linux
"apt:zsh-syntax-highlighting" = "latest"
"apt:zsh-autosuggestions" = "latest"
"apt:tmux" = "latest"
"apt:neovim" = "latest"
"apt:yazi" = "latest"
"apt:ffmpeg" = "latest"
"apt:fzf" = "latest"
"apt:bat" = "latest"
"apt:starship" = "latest"
"apt:podman" = "latest"

# GUI applications
{{- if eq .hostType "desktop" -}}
## macOS
"brew-cask:ghostty" = "latest"
"brew-cask:karabiner-elements" = "latest"
"brew-cask:brave-browser" = "latest"
"brew-cask:obsidian" = "latest"
"brew-cask:font-symbols-only-nerd-font" = "latest"
"brew-cask:font-jetbrains-mono" = "latest"
## Linux
"flatpak-user:obsidian" = "latest"
"apt:fonts-jetbrains-mono" = "latest"
{{- end }}

[bootstrap.hooks.post-packages]
{{ if eq $osID "ubuntu" "debian" }}
run = [
  "ln -sf /usr/bin/batcat ~/.local/bin/bat",
]
{{- else if eq .chezmoi.os "darwin" }}
run = [
  "brew install --cask nikitabobko/tap/aerospace"
]	
{{- end }}

[bootstrap.macos.defaults]
"NSGlobalDomain" = { NSWindowShouldDragOnGesture = true }

[tools]
# markdown
rumdl = "latest"  # linter and formatter
# lua
"aqua:lua-language-server" = "latest"
"aqua:JohnnyMorganz/StyLua" = "latest"
# python
python = "3.14"
"aqua:astral-sh/uv" = "0.12"
"pypi:ruff" = "0.16.0"
"pypi:pyrefly" = "1.3.2"
# node
node = "24.21.0"
pnpm = "12.10.1"
"npm:typescript-language-server" = "latest"
# rust
rust = "stable"
"cargo:cargo-binstall" = "latest"
"cargo:tree-sitter-cli" = "latest"


