# Setup default editor
export EDITOR=nvim
export MANPAGER="nvim +Man!"

# Initialize zsh completion system (compsys)
autoload -Uz compinit
# Cache the initialization here. -C requires removing this file to clear cache
compinit -C -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

# Use XDG dirs for completion and history files
# https://wiki.archlinux.org/title/XDG_Base_Directory#Partial
[ -d "$XDG_STATE_HOME"/zsh ] || mkdir -p "$XDG_STATE_HOME"/zsh
HISTFILE="$XDG_STATE_HOME"/zsh/history
[ -d "$XDG_CACHE_HOME"/zsh ] || mkdir -p "$XDG_CACHE_HOME"/zsh
zstyle ':completion:*' cache-path "$XDG_CACHE_HOME"/zsh/zcompcache
compinit -d "$XDG_CACHE_HOME"/zsh/zcompdump-$ZSH_VERSION

# Use XDG dirs for Vim versions < 9.1.0327 while keeping Neovim config separate
export VIMINIT="
  if has('nvim')
    so ${XDG_CONFIG_HOME:-$HOME/.config}/nvim/init.lua
  else
    set nocp
    so ${XDG_CONFIG_HOME:-$HOME/.config}/vim/vimrc
  endif
"

# vi mode
bindkey -v
bindkey '^?' backward-delete-char
bindkey '^H' backward-delete-char
# https://www.reddit.com/r/vim/comments/60jl7h/zsh_vimode_no_delay_entering_normal_mode/
# 10ms for key sequences
KEYTIMEOUT=1

# Aliases
alias v="vim"
alias vim="nvim"
alias cat="bat"
alias grep="rg"
alias cl="clear"

# Homebrew
export PATH="/opt/homebrew/bin:$PATH"

# fzf
source <(fzf --zsh)

# zoxide
eval "$(zoxide init zsh)"

# Starship
eval "$(starship init zsh)"

# NVM - Node version manager
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# VS Code CLI
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# PostgreSQL
export PATH="$PATH:/Library/PostgreSQL/16/bin"
export PGUSER=postgres

# GPG (for commit signing, password management, etc.)
export GPG_TTY=$(tty)

# Added by flyctl installer
export FLYCTL_INSTALL=$HOME/.fly/bin
export PATH="$FLYCTL_INSTALL/bin:$PATH"

# mise
# Keep mise activation after local PATH changes so managed tools win.
eval "$(~/.local/bin/mise activate zsh)"
